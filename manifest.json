{
  "manifest_version": 3,
  "name": "Commissar Study Watch",
  "version": "0.1.0",
  "description": "Persona voices that notice when you drift off your study material, and react to right and wrong homework answers. No AI needed.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "idle", "alarms", "storage", "offscreen", "tts", "scripting"],
  "optional_host_permissions": ["<all_urls>", "https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "src/sw.js", "type": "module" },
  "action": { "default_popup": "src/popup.html", "default_title": "Commissar Study Watch" },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.webassign.net/*", "file:///*WebAssign*", "file:///*webassign*"],
      "js": ["src/answers.js", "src/watch.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
